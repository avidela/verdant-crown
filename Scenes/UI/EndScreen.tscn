[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/UI/EndScreen.cs" id="1_end_screen"]

[node name="EndScreen" type="CanvasLayer"]
visible = false
process_mode = 3
script = ExtResource("1_end_screen")

[node name="Center" type="CenterContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="Layout" type="VBoxContainer" parent="Center/Panel"]
theme_override_constants/separation = 16

[node name="TitleLabel" type="Label" parent="Center/Panel/Layout"]
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 48
text = "GAME OVER"
horizontal_alignment = 1

[node name="HintLabel" type="Label" parent="Center/Panel/Layout"]
theme_override_colors/font_color = Color(0.85, 0.85, 0.85, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 20
text = "press J to retry"
horizontal_alignment = 1
